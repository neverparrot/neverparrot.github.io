    <draw:custom-shape draw:name="ru 65" draw:style-name="gr64" draw:text-style-name="P8" xml:id="id150" draw:id="id150" draw:layer="layout" svg:width="9.017cm" svg:height="1.425cm" svg:x="116.697cm" svg:y="59.423cm">
     <svg:title>text</svg:title>
     <text:p text:style-name="P7"><text:span text:style-name="T2">&lt;redline/&gt;append дописывает содержимое в конец нода-назначения, не изменяя уже имевшееся содержимое.</text:span></text:p>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:glue-points="10800 0 0 10800 10800 21600 21600 10800" draw:text-areas="0 0 21600 ?f11" draw:type="paper" draw:modifiers="18900" draw:enhanced-path="M 0 0 L 21600 0 21600 ?f0 ?f0 21600 0 21600 Z N M ?f0 21600 L ?f3 ?f0 C ?f8 ?f9 ?f10 ?f11 21600 ?f0 Z N">
      <draw:equation draw:name="f0" draw:formula="$0 "/>
      <draw:equation draw:name="f1" draw:formula="21600-?f0 "/>
      <draw:equation draw:name="f2" draw:formula="?f1 *8000/10800"/>
      <draw:equation draw:name="f3" draw:formula="21600-?f2 "/>
      <draw:equation draw:name="f4" draw:formula="?f1 /2"/>
      <draw:equation draw:name="f5" draw:formula="?f1 /4"/>
      <draw:equation draw:name="f6" draw:formula="?f1 /7"/>
      <draw:equation draw:name="f7" draw:formula="?f1 /16"/>
      <draw:equation draw:name="f8" draw:formula="?f3 +?f5 "/>
      <draw:equation draw:name="f9" draw:formula="?f0 +?f6 "/>
      <draw:equation draw:name="f10" draw:formula="21600-?f4 "/>
      <draw:equation draw:name="f11" draw:formula="?f0 +?f7 "/>
      <draw:handle draw:handle-position="$0 bottom" draw:handle-range-x-minimum="10800" draw:handle-range-x-maximum="21600"/>
     </draw:enhanced-geometry>
    </draw:custom-shape>
    <draw:connector draw:style-name="gr6" draw:text-style-name="P4" draw:layer="layout" svg:x1="115.308cm" svg:y1="72.422cm" svg:x2="116.697cm" svg:y2="60.136cm" draw:start-shape="id147" draw:start-glue-point="4" draw:end-shape="id150" draw:end-glue-point="5" svg:d="M115308 72422v-12286h1389" svg:viewBox="0 0 1390 12287">
     <text:p/>
    </draw:connector>
    <draw:custom-shape draw:name="ru 66" draw:style-name="gr65" draw:text-style-name="P8" xml:id="id151" draw:id="id151" draw:layer="layout" svg:width="8.694cm" svg:height="4.957cm" svg:x="116.648cm" svg:y="65.893cm">
     <svg:title>text</svg:title>
     <text:p text:style-name="P7"><text:span text:style-name="T2">&lt;redline/&gt;rewrite это комбинация append и eraseLeft. Этот режим создаёт пустую копию нода-назначения и вставляет её перед нодом назначения. Затем поочерёдно(с минимальной задержкой) выполняет </text:span><text:span text:style-name="T3">команду</text:span><text:span text:style-name="T2"> append на новом ноде-назначении, и </text:span><text:span text:style-name="T3">команду</text:span><text:span text:style-name="T2"> eraseLeft на старом ноде-назначении. Содержимое старого нода-назначения будет полностью удалено. Оба режима выполняются в одном контексте, и потому </text:span><text:span text:style-name="T3">команды</text:span><text:span text:style-name="T2"> нода-предписания, содержащего информацию для append влияют и на eraseLeft. Нодом-предписанием для eraseLeft служит копия старого нода-назначения, создаваемая автоматически. Так как </text:span><text:span text:style-name="T3">команды</text:span><text:span text:style-name="T2"> для append влияют на оба режима, дополнительные </text:span><text:span text:style-name="T3">команды</text:span><text:span text:style-name="T2"> для eraseLeft в автоматически созданном ноде-предписании не создаются. за ненадобностью.</text:span></text:p>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:glue-points="10800 0 0 10800 10800 21600 21600 10800" draw:text-areas="0 0 21600 ?f11" draw:type="paper" draw:modifiers="18900" draw:enhanced-path="M 0 0 L 21600 0 21600 ?f0 ?f0 21600 0 21600 Z N M ?f0 21600 L ?f3 ?f0 C ?f8 ?f9 ?f10 ?f11 21600 ?f0 Z N">
      <draw:equation draw:name="f0" draw:formula="$0 "/>
      <draw:equation draw:name="f1" draw:formula="21600-?f0 "/>
      <draw:equation draw:name="f2" draw:formula="?f1 *8000/10800"/>
      <draw:equation draw:name="f3" draw:formula="21600-?f2 "/>
      <draw:equation draw:name="f4" draw:formula="?f1 /2"/>
      <draw:equation draw:name="f5" draw:formula="?f1 /4"/>
      <draw:equation draw:name="f6" draw:formula="?f1 /7"/>
      <draw:equation draw:name="f7" draw:formula="?f1 /16"/>
      <draw:equation draw:name="f8" draw:formula="?f3 +?f5 "/>
      <draw:equation draw:name="f9" draw:formula="?f0 +?f6 "/>
      <draw:equation draw:name="f10" draw:formula="21600-?f4 "/>
      <draw:equation draw:name="f11" draw:formula="?f0 +?f7 "/>
      <draw:handle draw:handle-position="$0 bottom" draw:handle-range-x-minimum="10800" draw:handle-range-x-maximum="21600"/>
     </draw:enhanced-geometry>
    </draw:custom-shape>
    <draw:connector draw:style-name="gr6" draw:text-style-name="P4" draw:layer="layout" svg:x1="115.308cm" svg:y1="72.422cm" svg:x2="116.648cm" svg:y2="68.372cm" draw:start-shape="id147" draw:start-glue-point="4" draw:end-shape="id151" draw:end-glue-point="5" svg:d="M115308 72422v-4050h1340" svg:viewBox="0 0 1341 4051">
