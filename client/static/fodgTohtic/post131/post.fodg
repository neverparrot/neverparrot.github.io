    <draw:connector draw:style-name="gr6" draw:text-style-name="P4" draw:layer="layout" svg:x1="115.512cm" svg:y1="129.953cm" svg:x2="116.93cm" svg:y2="114.952cm" draw:start-shape="id516" draw:start-glue-point="4" draw:end-shape="id517" draw:end-glue-point="3" svg:d="M115512 129953v-15001h1418" svg:viewBox="0 0 1419 15002">
