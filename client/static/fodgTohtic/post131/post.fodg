    <draw:custom-shape draw:name="ru 199" draw:style-name="gr173" draw:text-style-name="P9" xml:id="id518" draw:id="id518" draw:layer="layout" svg:width="8.694cm" svg:height="1.263cm" svg:x="116.851cm" svg:y="115.524cm">
     <svg:title>text</svg:title>
     <text:p text:style-name="P7"><text:span text:style-name="T2">&lt;redline/&gt;Commands are executed in accordance with the set mode. There are 5 modes: replace, append, erase a.k.a. backspace, eraseLeft a.k.a. delete, rewrite.</text:span></text:p>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:glue-points="10800 0 0 10800 10800 21600 21600 10800" draw:text-areas="0 0 21600 ?f11" draw:type="paper" draw:modifiers="18900" draw:enhanced-path="M 0 0 L 21600 0 21600 ?f0 ?f0 21600 0 21600 Z N M ?f0 21600 L ?f3 ?f0 C ?f8 ?f9 ?f10 ?f11 21600 ?f0 Z N">
      <draw:equation draw:name="f0" draw:formula="$0 "/>
