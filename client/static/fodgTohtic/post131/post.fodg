    <draw:connector draw:style-name="gr6" draw:text-style-name="P4" draw:layer="layout" svg:x1="115.512cm" svg:y1="129.953cm" svg:x2="116.851cm" svg:y2="116.156cm" draw:start-shape="id516" draw:start-glue-point="4" draw:end-shape="id518" draw:end-glue-point="5" svg:d="M115512 129953v-13797h1339" svg:viewBox="0 0 1340 13798">
