    </draw:connector>
    <draw:custom-shape draw:name="ru 200" draw:style-name="gr175" draw:text-style-name="P9" xml:id="id519" draw:id="id519" draw:layer="layout" svg:width="9.017cm" svg:height="1.425cm" svg:x="116.901cm" svg:y="116.954cm">
     <svg:title>text</svg:title>
     <text:p text:style-name="P7"><text:span text:style-name="T2">&lt;redline/&gt;append writes new content after the existing content of the destination node. The existing content remains intact.</text:span></text:p>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:glue-points="10800 0 0 10800 10800 21600 21600 10800" draw:text-areas="0 0 21600 ?f11" draw:type="paper" draw:modifiers="18900" draw:enhanced-path="M 0 0 L 21600 0 21600 ?f0 ?f0 21600 0 21600 Z N M ?f0 21600 L ?f3 ?f0 C ?f8 ?f9 ?f10 ?f11 21600 ?f0 Z N">
      <draw:equation draw:name="f0" draw:formula="$0 "/>
      <draw:equation draw:name="f1" draw:formula="21600-?f0 "/>
      <draw:equation draw:name="f2" draw:formula="?f1 *8000/10800"/>
      <draw:equation draw:name="f3" draw:formula="21600-?f2 "/>
      <draw:equation draw:name="f4" draw:formula="?f1 /2"/>
      <draw:equation draw:name="f5" draw:formula="?f1 /4"/>
      <draw:equation draw:name="f6" draw:formula="?f1 /7"/>
      <draw:equation draw:name="f7" draw:formula="?f1 /16"/>
      <draw:equation draw:name="f8" draw:formula="?f3 +?f5 "/>
      <draw:equation draw:name="f9" draw:formula="?f0 +?f6 "/>
      <draw:equation draw:name="f10" draw:formula="21600-?f4 "/>
      <draw:equation draw:name="f11" draw:formula="?f0 +?f7 "/>
      <draw:handle draw:handle-position="$0 bottom" draw:handle-range-x-minimum="10800" draw:handle-range-x-maximum="21600"/>
     </draw:enhanced-geometry>
    </draw:custom-shape>
    <draw:connector draw:style-name="gr6" draw:text-style-name="P4" draw:layer="layout" svg:x1="115.512cm" svg:y1="129.953cm" svg:x2="116.901cm" svg:y2="117.667cm" draw:start-shape="id516" draw:start-glue-point="4" draw:end-shape="id519" draw:end-glue-point="5" svg:d="M115512 129953v-12286h1389" svg:viewBox="0 0 1390 12287">
     <text:p/>
    </draw:connector>
    <draw:custom-shape draw:name="ru 201" draw:style-name="gr176" draw:text-style-name="P9" xml:id="id520" draw:id="id520" draw:layer="layout" svg:width="8.694cm" svg:height="4.957cm" svg:x="116.852cm" svg:y="123.424cm">
     <svg:title>text</svg:title>
     <text:p text:style-name="P7"><text:span text:style-name="T2">&lt;redline/&gt;rewrite is a combination of append and eraseLeft. This mode first creates an empty clone of the destination node and inserts it before the destination node. It then alternates commands with minimal delay. It applies append on the new destination node and eraseLeft on the old destination node. The content of the old destination node will eventually be erased completely Both mode-commands are executed in the same context so the prescription for append affects eraseLeft also. The prescription for eraseLeft is the automatically created copy of the old destination node. Given how commands for append affect eraseLeft there is no need for extra commands in the automatically created prescription for eraseLeft.</text:span></text:p>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:glue-points="10800 0 0 10800 10800 21600 21600 10800" draw:text-areas="0 0 21600 ?f11" draw:type="paper" draw:modifiers="18900" draw:enhanced-path="M 0 0 L 21600 0 21600 ?f0 ?f0 21600 0 21600 Z N M ?f0 21600 L ?f3 ?f0 C ?f8 ?f9 ?f10 ?f11 21600 ?f0 Z N">
      <draw:equation draw:name="f0" draw:formula="$0 "/>
      <draw:equation draw:name="f1" draw:formula="21600-?f0 "/>
      <draw:equation draw:name="f2" draw:formula="?f1 *8000/10800"/>
      <draw:equation draw:name="f3" draw:formula="21600-?f2 "/>
      <draw:equation draw:name="f4" draw:formula="?f1 /2"/>
      <draw:equation draw:name="f5" draw:formula="?f1 /4"/>
      <draw:equation draw:name="f6" draw:formula="?f1 /7"/>
      <draw:equation draw:name="f7" draw:formula="?f1 /16"/>
      <draw:equation draw:name="f8" draw:formula="?f3 +?f5 "/>
      <draw:equation draw:name="f9" draw:formula="?f0 +?f6 "/>
      <draw:equation draw:name="f10" draw:formula="21600-?f4 "/>
      <draw:equation draw:name="f11" draw:formula="?f0 +?f7 "/>
      <draw:handle draw:handle-position="$0 bottom" draw:handle-range-x-minimum="10800" draw:handle-range-x-maximum="21600"/>
     </draw:enhanced-geometry>
    </draw:custom-shape>
    <draw:connector draw:style-name="gr6" draw:text-style-name="P4" draw:layer="layout" svg:x1="115.512cm" svg:y1="129.953cm" svg:x2="116.852cm" svg:y2="125.903cm" draw:start-shape="id516" draw:start-glue-point="4" draw:end-shape="id520" draw:end-glue-point="5" svg:d="M115512 129953v-4050h1340" svg:viewBox="0 0 1341 4051">
     <text:p/>
    </draw:connector>
    <draw:connector draw:style-name="gr66" draw:text-style-name="P3" draw:layer="layout" draw:type="line" svg:x1="111.311cm" svg:y1="130.448cm" svg:x2="115.004cm" svg:y2="130.461cm" draw:start-shape="id513" draw:end-shape="id516" svg:d="M111311 130448l3693 13" svg:viewBox="0 0 3694 14">
     <text:p/>
    </draw:connector>
    <draw:custom-shape draw:name="ru 202" draw:style-name="gr175" draw:text-style-name="P9" xml:id="id521" draw:id="id521" draw:layer="layout" svg:width="9.017cm" svg:height="1.425cm" svg:x="116.901cm" svg:y="118.554cm">
     <svg:title>text</svg:title>
     <text:p text:style-name="P7"><text:span text:style-name="T2">&lt;redline/&gt;replace instantly and completely erases the previous content of the destination node to then replace it with the new content.</text:span></text:p>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:glue-points="10800 0 0 10800 10800 21600 21600 10800" draw:text-areas="0 0 21600 ?f11" draw:type="paper" draw:modifiers="18900" draw:enhanced-path="M 0 0 L 21600 0 21600 ?f0 ?f0 21600 0 21600 Z N M ?f0 21600 L ?f3 ?f0 C ?f8 ?f9 ?f10 ?f11 21600 ?f0 Z N">
      <draw:equation draw:name="f0" draw:formula="$0 "/>
      <draw:equation draw:name="f1" draw:formula="21600-?f0 "/>
      <draw:equation draw:name="f2" draw:formula="?f1 *8000/10800"/>
      <draw:equation draw:name="f3" draw:formula="21600-?f2 "/>
      <draw:equation draw:name="f4" draw:formula="?f1 /2"/>
      <draw:equation draw:name="f5" draw:formula="?f1 /4"/>
      <draw:equation draw:name="f6" draw:formula="?f1 /7"/>
      <draw:equation draw:name="f7" draw:formula="?f1 /16"/>
      <draw:equation draw:name="f8" draw:formula="?f3 +?f5 "/>
      <draw:equation draw:name="f9" draw:formula="?f0 +?f6 "/>
      <draw:equation draw:name="f10" draw:formula="21600-?f4 "/>
      <draw:equation draw:name="f11" draw:formula="?f0 +?f7 "/>
      <draw:handle draw:handle-position="$0 bottom" draw:handle-range-x-minimum="10800" draw:handle-range-x-maximum="21600"/>
     </draw:enhanced-geometry>
    </draw:custom-shape>
    <draw:custom-shape draw:name="ru 203" draw:style-name="gr175" draw:text-style-name="P9" xml:id="id522" draw:id="id522" draw:layer="layout" svg:width="9.017cm" svg:height="1.425cm" svg:x="116.901cm" svg:y="120.154cm">
     <svg:title>text</svg:title>
     <text:p text:style-name="P7"><text:span text:style-name="T2">&lt;redline/&gt;erase a.k.a. backspace performs a symbol-wise removal beginning from the right. The number of erased symbols equals to the number of symbols in the prescription node.</text:span></text:p>
     <draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:glue-points="10800 0 0 10800 10800 21600 21600 10800" draw:text-areas="0 0 21600 ?f11" draw:type="paper" draw:modifiers="18900" draw:enhanced-path="M 0 0 L 21600 0 21600 ?f0 ?f0 21600 0 21600 Z N M ?f0 21600 L ?f3 ?f0 C ?f8 ?f9 ?f10 ?f11 21600 ?f0 Z N">
      <draw:equation draw:name="f0" draw:formula="$0 "/>
      <draw:equation draw:name="f1" draw:formula="21600-?f0 "/>
      <draw:equation draw:name="f2" draw:formula="?f1 *8000/10800"/>
      <draw:equation draw:name="f3" draw:formula="21600-?f2 "/>
      <draw:equation draw:name="f4" draw:formula="?f1 /2"/>
      <draw:equation draw:name="f5" draw:formula="?f1 /4"/>
      <draw:equation draw:name="f6" draw:formula="?f1 /7"/>
      <draw:equation draw:name="f7" draw:formula="?f1 /16"/>
      <draw:equation draw:name="f8" draw:formula="?f3 +?f5 "/>
      <draw:equation draw:name="f9" draw:formula="?f0 +?f6 "/>
      <draw:equation draw:name="f10" draw:formula="21600-?f4 "/>
      <draw:equation draw:name="f11" draw:formula="?f0 +?f7 "/>
      <draw:handle draw:handle-position="$0 bottom" draw:handle-range-x-minimum="10800" draw:handle-range-x-maximum="21600"/>
     </draw:enhanced-geometry>
    </draw:custom-shape>
